# PostgreSQL 데이터베이스 연결 URL (Coolify 내부 네트워크 또는 로컬 Docker)
DATABASE_URL="postgresql://babyuser:babypassword@localhost:5432/baby_db?schema=public"

# OCI Object Storage (S3 호환 API 설정 - 육아일기 사진/영상 저장용)
OCI_S3_ENDPOINT="https://<namespace>.compat.objectstorage.ap-chuncheon-1.oraclecloud.com"
OCI_S3_REGION="ap-chuncheon-1"
OCI_S3_BUCKET="baby-diary-media"
OCI_S3_ACCESS_KEY_ID="your-access-key"
OCI_S3_SECRET_ACCESS_KEY="your-secret-key"
