// ============================================================================
// Baby Buddy & Memos 레퍼런스 기반 통합 육아 기록 + 육아일기 DB 스키마
// 타겟 DB: PostgreSQL 16 (OCI + Coolify 매니지드 DB)
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 가족 내 역할 구분
enum MemberRole {
  OWNER      // 생성자 (주 양육자)
  PARENT     // 공동 부모 (엄마/아빠)
  CAREGIVER  // 조부모, 베이비시터 등
}

// 아이 성별
enum Gender {
  M
  F
  UNKNOWN
}

// 일상 육아 기록 카테고리 (Baby Buddy 핵심 모델 통합)
enum ActivityCategory {
  FEEDING      // 수유 (모유, 분유, 유축수유, 이유식)
  SLEEP        // 수면 (낮잠, 밤잠)
  DIAPER       // 배변/기저귀 (소변, 대변, 혼합)
  PUMPING      // 유축 (좌/우 ml)
  TEMPERATURE  // 체온 (°C)
  MEDICATION   // 투약 (해열제, 영양제 등)
  BATH         // 목욕
  TUMMY_TIME   // 터미타임 / 배앓이
  NOTE         // 기타 특이사항 메모
}

// 실시간 작동 타이머 카테고리
enum TimerCategory {
  FEEDING_LEFT   // 모유수유 (왼쪽)
  FEEDING_RIGHT  // 모유수유 (오른쪽)
  SLEEP          // 수면
  PUMPING        // 유축
  TUMMY_TIME     // 터미타임
}

// 타이머 상태
enum TimerStatus {
  RUNNING
  PAUSED
}

// 사용자 계정
model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  name         String
  avatarUrl    String?           @map("avatar_url")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  households   HouseholdMember[]
  activityLogs ActivityLog[]
  activeTimers ActiveTimer[]
  diaryEntries DiaryEntry[]

  @@map("users")
}

// 가족 그룹 (공동 육아 단위)
model Household {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            // 예: "튼튼이네 가족"
  inviteCode String            @unique @map("invite_code")
  createdAt  DateTime          @default(now()) @map("created_at")

  members    HouseholdMember[]
  babies     Baby[]

  @@map("households")
}

// 가족 구성원 매핑
model HouseholdMember {
  id            String     @id @default(uuid()) @db.Uuid
  householdId   String     @map("household_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  role          MemberRole @default(PARENT)
  relationLabel String     @map("relation_label") // "엄마", "아빠", "할머니" 등
  joinedAt      DateTime   @default(now()) @map("joined_at")

  household     Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// 아이 프로필 (다둥이 지원)
model Baby {
  id            String         @id @default(uuid()) @db.Uuid
  householdId   String         @map("household_id") @db.Uuid
  name          String         // 아이 이름 또는 태명
  birthDate     DateTime       @map("birth_date") @db.Date
  dueDate       DateTime?      @map("due_date") @db.Date // 출산예정일 (이른둥이 교정일수 계산용)
  gender        Gender         @default(UNKNOWN)
  bloodType     String?        @map("blood_type")
  photoUrl      String?        @map("photo_url")
  createdAt     DateTime       @default(now()) @map("created_at")

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activityLogs  ActivityLog[]
  activeTimers  ActiveTimer[]
  growthRecords GrowthRecord[]
  diaryEntries  DiaryEntry[]

  @@index([householdId])
  @@map("babies")
}

// 통합 육아 트래킹 로그 (타임라인 고속 조회 + JSONB 상세 속성)
model ActivityLog {
  id          String           @id @default(uuid()) @db.Uuid
  babyId      String           @map("baby_id") @db.Uuid
  recordedBy  String?          @map("recorded_by") @db.Uuid
  category    ActivityCategory
  startedAt   DateTime         @map("started_at") // 발생 시각 또는 시작 시각
  endedAt     DateTime?        @map("ended_at")   // 종료 시각 (수면, 모유수유 등)
  durationSec Int?             @map("duration_sec") // 지속 시간(초)
  amountMl    Float?           @map("amount_ml")    // 수유량/유축량(ml) - 통계 집계용
  valueNum    Float?           @map("value_num")    // 체온(36.5) 등 수치 기록용
  details     Json             @default("{}") @db.JsonB // 카테고리별 세부 데이터(모유 좌/우, 대변 상태 등)
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  baby        Baby             @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recorder    User?            @relation(fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([babyId, startedAt(sort: Desc)])
  @@index([babyId, category, startedAt(sort: Desc)])
  @@index([recordedBy])
  @@map("activity_logs")
}

// 가족 간 실시간 동기화되는 활성 타이머 (Baby Buddy Timer 대응)
model ActiveTimer {
  id             String        @id @default(uuid()) @db.Uuid
  babyId         String        @map("baby_id") @db.Uuid
  startedBy      String?       @map("started_by") @db.Uuid
  category       TimerCategory
  startedAt      DateTime      @map("started_at")
  pausedAt       DateTime?     @map("paused_at")
  accumulatedSec Int           @default(0) @map("accumulated_sec")
  status         TimerStatus   @default(RUNNING)
  note           String?
  updatedAt      DateTime      @updatedAt @map("updated_at")

  baby           Baby          @relation(fields: [babyId], references: [id], onDelete: Cascade)
  starter        User?         @relation(fields: [startedBy], references: [id], onDelete: SetNull)

  @@index([babyId, status])
  @@index([startedBy])
  @@map("active_timers")
}

// 신체 발달 및 성장 기록 (키, 몸무게, 머리둘레)
model GrowthRecord {
  id           String   @id @default(uuid()) @db.Uuid
  babyId       String   @map("baby_id") @db.Uuid
  measuredDate DateTime @map("measured_date") @db.Date
  weightKg     Float?   @map("weight_kg") // 몸무게 (kg)
  heightCm     Float?   @map("height_cm") // 키 (cm)
  headCm       Float?   @map("head_cm")   // 머리둘레 (cm)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  baby         Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([babyId, measuredDate(sort: Desc)])
  @@map("growth_records")
}

// 감성 육아일기 (Memos / Monica 스타일 타임라인 저널)
model DiaryEntry {
  id          String       @id @default(uuid()) @db.Uuid
  babyId      String       @map("baby_id") @db.Uuid
  authorId    String?      @map("author_id") @db.Uuid
  diaryDate   DateTime     @map("diary_date") @db.Date
  title       String?
  content     String       // 일기 본문 (마크다운 지원)
  mood        String?      // 오늘의 기분 이모지 (😊, 😴, 😭, 🥰 등)
  tags        String[]     // 해시태그 배열 (["첫뒤집기", "100일"])
  isMilestone Boolean      @default(false) @map("is_milestone") // 발달 이정표 여부
  dailySummary Json?       @map("daily_summary") @db.JsonB // 작성 시점의 수유·수면·기저귀 요약 스냅샷
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  baby        Baby         @relation(fields: [babyId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  media       DiaryMedia[]

  @@index([babyId, diaryDate(sort: Desc)])
  @@index([authorId])
  @@map("diary_entries")
}

// 육아일기 첨부 미디어 (OCI Object Storage 연동)
model DiaryMedia {
  id        String     @id @default(uuid()) @db.Uuid
  diaryId   String     @map("diary_id") @db.Uuid
  mediaUrl  String     @map("media_url") // OCI Object Storage 객체 키 (diary/<babyId>/<diaryId>/<uuid>.<ext>)
  mediaType String     @default("IMAGE") @map("media_type") // IMAGE | VIDEO
  sortOrder Int        @default(0) @map("sort_order")

  diary     DiaryEntry @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@map("diary_media")
}
